# Configuration for F.R.I.D.A.Y AI Assistant
# Copy this file to .env and modify values as needed

# AI Configuration
# Available models: phi3:mini, mistral, llama2, neural-chat, etc.
# For a list of available models: ollama list
MODEL_NAME=phi3:mini

# Name of the AI assistant
AI_NAME=F.R.I.D.A.Y

# Name of the user/boss
BOSS_NAME=Sir

# System Configuration - Path for data storage
# Use relative path (./data) or absolute path (/home/user/data)
DATA_PATH=./data

# Ollama Configuration
# Connection URL for Ollama service
# Default: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Memory Configuration
# Name of the memory/history file
MEMORY_FILE=memory.json

# Maximum number of conversation history entries to keep
# Higher values = more context but slower processing
MAX_HISTORY=10

# Voice Configuration (offline)
# Vosk model path is required for voice input
VOICE_ASR_MODEL=./models/vosk-model-small-en-us-0.15
VOICE_WAKE_WORD=hey_jarvis
VOICE_SAMPLE_RATE=16000
VOICE_FRAME_MS=20
VOICE_WAKE_THRESHOLD=0.7
VOICE_SILENCE_MS=800
VOICE_MAX_RECORD_MS=8000
VOICE_VAD_AGGRESSIVENESS=2
# Leave empty to use default input device
VOICE_DEVICE=

# TTS Configuration (offline)
TTS_ENABLED=true
TTS_RATE=175
TTS_VOLUME=1.0
TTS_VOICE_ID=
